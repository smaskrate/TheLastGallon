<?xml version="1.0" encoding="utf-8"?>
<!-- The Last Gallon: the fermentation vessel carried in both arms. An item
     whose script says primaryAnimMask = tlgcarryvessel sets RightHandMask to
     it while held (BC ModelManager.addMaskingModel); this node then plays
     Bob_TLG_CarryVessel (media/anims_X/Bob) on both clavicles' subtrees and
     the prop bones, as vanilla's holdingbagright.xml plays its clip on the
     right arm. The clip is the arms of two Mixamo "Carrying" clips blended
     halfway and retargeted by tools/blender/pz_arms.py (provenance:
     art-src/carry/PROVENANCE.md); it also places Bip01_Prop1, the vessel's
     bone, in front of the chest. Checked in game: docs/test-results.md. -->
<animNode>
	<m_Name>tlgcarryvessel</m_Name>
	<m_Priority>10</m_Priority>
	<m_AnimName>Bob_TLG_CarryVessel</m_AnimName>
	<m_BlendTime>0.20</m_BlendTime>
	<m_SpeedScale>1.00</m_SpeedScale>
	<m_Conditions x_name="a1c4e7f2-3b5d-4e8a-9c1f-2d6b8a0e4c75">
		<m_Name>RightHandMask</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>tlgcarryvessel</m_Value>
	</m_Conditions>
	<m_SubStateBoneWeights>
		<boneName>Bip01</boneName>
		<weight>0.00</weight>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_R_Clavicle</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_L_Clavicle</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_Prop1</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_Prop2</boneName>
	</m_SubStateBoneWeights>
</animNode>
