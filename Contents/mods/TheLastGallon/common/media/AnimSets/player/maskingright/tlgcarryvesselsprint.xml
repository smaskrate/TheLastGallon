<?xml version="1.0" encoding="utf-8"?>
<!-- The Last Gallon: the fermentation vessel carried in both arms while
     sprinting, crouched or not. With the vessel's RightHandMask, isSprinting
     and isMoving true it has more conditions than tlgcarryvessel.xml and
     tlgcarryvesselsneak.xml, so the game plays it instead of either (BC
     AnimState.getAnimNodes plays the matching nodes with the most
     conditions); isMoving keeps it apart from tlgcarryvesselsneakidle.xml.
     The game's sprint leans the chest 41 degrees and twists it through
     each stride, and a player's arms hang from Bip01_Spine1 (BC
     IsoPlayer.onAnimPlayerCreated), so the standing clip tilts and swings
     the vessel (runs 108 and 116). This clip, Bob_TLG_CarryVesselSprint
     (media/anims_X/Bob), runs as long as the game's Bob_Sprint and holds the
     same arms keyed against each of its keys by tools/blender/pz_arms.py,
     in their standing directions, with the vessel upright 0.17 file units
     in front of the hands and 0.10 down (art-src/carry/PROVENANCE.md). The
     game moves a looping track in this layer to the body's time fraction
     (BC AnimLayer.findSyncTrack), so the arms keep step with the stride.
     Checked in game: docs/test-results.md. -->
<animNode>
	<m_Name>tlgcarryvesselsprint</m_Name>
	<m_Priority>10</m_Priority>
	<m_AnimName>Bob_TLG_CarryVesselSprint</m_AnimName>
	<m_BlendTime>0.15</m_BlendTime>
	<m_SpeedScale>1.00</m_SpeedScale>
	<m_Conditions x_name="9584874e-7388-4b2f-b8dd-96952dfe77b2">
		<m_Name>RightHandMask</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>tlgcarryvessel</m_Value>
	</m_Conditions>
	<m_Conditions x_name="5dc8ff85-1587-4e2f-91d3-56b132b46f4c">
		<m_Name>isSprinting</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions x_name="6ebe0187-1de4-40a3-a27a-7d69d8115f77">
		<m_Name>isMoving</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_SubStateBoneWeights>
		<boneName>Bip01</boneName>
		<weight>0.00</weight>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_R_Clavicle</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_L_Clavicle</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_Prop1</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_Prop2</boneName>
	</m_SubStateBoneWeights>
</animNode>
